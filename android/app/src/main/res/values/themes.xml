<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CESIZenBreathing" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/heading</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:statusBarColor">@color/heading</item>

        <item name="materialButtonStyle">@style/Widget.Cesizen.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Cesizen.Card</item>
        <item name="textInputStyle">@style/Widget.Cesizen.TextInput</item>
        <item name="toolbarStyle">@style/Widget.Cesizen.Toolbar</item>
    </style>

    <style name="Widget.Cesizen.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">@color/primary_hover</item>
    </style>

    <style name="Widget.Cesizen.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">@color/secondary_hover</item>
    </style>

    <style name="Widget.Cesizen.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Cesizen.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxStrokeColor">@color/input_border</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="Widget.Cesizen.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">#dc2626</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Cesizen.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/heading</item>
        <item name="titleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <style name="TextHeading">
        <item name="android:textColor">@color/heading</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextSubHeading">
        <item name="android:textColor">@color/heading</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextCardTitle">
        <item name="android:textColor">@color/heading</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextBody">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextMuted">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
