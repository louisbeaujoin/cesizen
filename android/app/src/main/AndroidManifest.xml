<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CESIZenBreathing"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ExerciseActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".InformationDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AdminUsersActivity"
            android:exported="false"
            android:parentActivityName=".AdminActivity" />

        <activity
            android:name=".AdminUserFormActivity"
            android:exported="false"
            android:parentActivityName=".AdminUsersActivity" />

        <activity
            android:name=".AdminExercisesActivity"
            android:exported="false"
            android:parentActivityName=".AdminActivity" />

        <activity
            android:name=".AdminExerciseFormActivity"
            android:exported="false"
            android:parentActivityName=".AdminExercisesActivity" />

        <activity
            android:name=".AdminInfoPagesActivity"
            android:exported="false"
            android:parentActivityName=".AdminActivity" />

        <activity
            android:name=".AdminPageFormActivity"
            android:exported="false"
            android:parentActivityName=".AdminInfoPagesActivity" />
    </application>

</manifest>
